# Resend — formulario de contacto (SPEC 03). Solo servidor, nunca NEXT_PUBLIC_.

# API key de Resend (https://resend.com/api-keys). Pégala después del "=".
RESEND_API_KEY=

# Correo que recibe los mensajes. Con onboarding@resend.dev debe ser el
# correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. Opcional; por defecto onboarding@resend.dev.
CONTACT_FROM_EMAIL=onboarding@resend.dev

SUPABASE_DB_PASSWORD=

# Supabase — conexión con Next.js (SPEC 04).
# Las variables NEXT_PUBLIC_* se incrustan al compilar: si las cambias,
# reinicia `npm run dev` o vuelve a compilar.
# URL del proyecto (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (sb_publishable_...). Pensada para el navegador.
# Nunca pongas aquí la service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=